{
  "name": "bga-dsh-client",
  "version": "0.0.9",
  "private": true,
  "description": "DSH Web GUI 的 Tauri 桌面壳：自动探测/拉起 dsh 服务、托盘常驻、局域网代理配对访问（内置 Node 版 / 依赖系统 npx 版）",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "icon": "tauri icon",
    "bundled": "./scripts/build-release.sh bundled",
    "two": "./scripts/build-release.sh two",
    "lint": "eslint \"ui/assets/*.js\" \"scripts/*.mjs\"",
    "lint:fix": "eslint --fix \"ui/assets/*.js\" \"scripts/*.mjs\"",
    "format": "prettier --write \"ui/assets/*.{js,css}\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"ui/assets/*.{js,css}\" \"*.json\" \"*.mjs\"",
    "clean": "bash ./scripts/clean.sh",
    "clean:all": "bash ./scripts/clean.sh --all"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "eslint": "^9.39.4",
    "globals": "^15.14.0",
    "prettier": "^3.9.6"
  },
  "license": "MIT",
  "author": "bingoogolapple"
}
